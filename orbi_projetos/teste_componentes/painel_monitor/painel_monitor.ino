// Faz o display funcionar
void formatacaoDisplay()
{
    /* CONFIGURÇÃO DO DISPLAY */
    display.clearDisplay();      // Limpa a tela
    display.setTextSize(1);      // Tamanho do texto
    display.setTextColor(WHITE); // Cor do texto
    display.setCursor(0, 0);     // Posição do cursor
}

// Funções Para Telas de Exibição OLED
void painel_menu()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.println("ORBI ENGENIEERS");
    display.println("");
    display.println("Orbisat");
    display.println("PUC Minas");
    display.println("");
    display.println("Qualquer tecla troca de painel"); // Instruções para utilizar a placa da Franzininho Wifi no projeto
    display.display();                                 // Faz com que toda informação de texto seja exibida no monitor
}

void painel_principal()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.println("PAINEL PRINCIPAL");
    display.println("");
    display.print("Termometro:");     // Termômetro - Priorizar a temperatura em °C
    display.print(temperaturaPainel); // Termômetro - Priorizar a temperatura em °C
    display.println("\tC");           // Termômetro - Priorizar a temperatura em °C
    display.print("Umidade do Ar:");  // Umidade Relativa do Ar
    display.print(umidadePainel);     // Umidade Relativa do Ar
    display.println("%");             // Umidade Relativa do Ar

    display.print("Piranometro:");    // Heliógrafo
    display.print(piranometroPainel); // Heliógrafo
    display.println("%");             // Heliógrafo

    display.print("Umidade Solo:");          // Umidade do Solo
