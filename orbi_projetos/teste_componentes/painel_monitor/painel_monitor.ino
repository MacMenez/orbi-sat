    display.display(); // Faz com que toda informação de texto seja exibida no monitor
}

void painel_info_pluvial()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.println("PLUVIOMETRO");
    display.println("");
    display.print("Percentual de Chuva: ");
    display.print(porcentagemChuvaPainel); // Mostra a intensidade da chuva
    display.println("%");
    display.println("");
    display.print("ESTADO: ");            // Mostra a intensidade da chuva
    display.println(previsaoChuvaPainel); // Mostra a intensidade da chuva
    display.println("");
    display.display(); // Faz com que toda informação de texto seja exibida no monitor
}

void painel_info_solo()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.print("UMIDADE DA TERRA: ");
    display.print(percentualUmidadePainel);
    display.println("%");
    display.println("");
    display.print("ESTADO: ");          // Mostra o quão molhada a terra está
    display.println(monitorSecaPainel); // Mostra o quão molhada a terra está
    display.println("");
    display.println(irrigacaoPainel); // Mostra o quão molhada a terra está
    display.println("");

    // display.println("ALERTA: RISCO DE ALAGAMENTO"); // Mensagem para aviso alagamentos
    display.display(); // Faz com que toda informação de texto seja exibida no monitor
}

void menu(int opcao)
{
    switch (opcao)
    {
    case 1:
        painel_menu();
        break;

    case 2:
        painel_principal();
        break;

    case 3:
        painel_info_solar();
        break;

    case 4:
        painel_info_termometro();
        break;

    case 5:
        painel_info_umidade();
        break;

    case 6:
        painel_info_pluvial();
        break;

    case 7:
        painel_info_solo();
        break;

    default:
        formatacaoDisplay();
        display.println("ERRO DE NO MENU! \nVerificar valores enviados");
        display.display();
    }
}
