// Faz o display funcionar
void formatacaoDisplay()
{
    /* CONFIGURÇÃO DO DISPLAY */
    display.clearDisplay();      // Limpa a tela
    display.setTextSize(1);      // Tamanho do texto
    display.setTextColor(WHITE); // Cor do texto
    display.setCursor(0, 0);     // Posição do cursor
}

// Funções Para Telas de Exibição OLED
void painel_menu()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.println("ORBI ENGENIERS");
    display.println("");
    display.println("Satélite ORBI");
    display.println("PUC Minas");
    display.println("");
    display.println("Qualquer tecla troca de painel"); // Instruções para utilizar a placa da Franzininho Wifi no projeto
    display.display();                                 // Faz com que toda informação de texto seja exibida no monitor
}

void painel_principal()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.println("PAINEL PRINCIPAL");
    display.println("");
    display.print("Termometro:");     // Termômetro - Priorizar a temperatura em °C
    display.print(temperaturaPainel); // Termômetro - Priorizar a temperatura em °C
    display.println("\tC");           // Termômetro - Priorizar a temperatura em °C
    display.print("Umidade do Ar:");  // Umidade Relativa do Ar
    display.print(umidadePainel);     // Umidade Relativa do Ar
    display.println("%");             // Umidade Relativa do Ar

    display.print("Piranometro:");    // Heliógrafo
    display.print(piranometroPainel); // Heliógrafo
    display.println("%");             // Heliógrafo

    display.print("Umidade Solo:");          // Umidade do Solo
    display.print(percentualUmidadePainel);  // Umidade do Solo
    display.println("%");                    // Umidade do Solo
    display.print("Pluviometro: ");          // Pluviômetro
    display.println(porcentagemChuvaPainel); // Pluviômetro
    display.display();                       // Faz com que toda informação de texto seja exibida no monitor
}

void painel_info_solar()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.println("HELIOGRAFO");
    display.println("");
    display.println(statusAnomaliaPainel); // Informa o quanto de luz solar esta sendo registrada em determinada região
    // display.println(statusEcossistemaPainel);                           // Informa o quanto de luz solar esta sendo registrada em determinada região
    display.println("");
    display.println("PIRANOMETRO");
    display.println("");
    display.print("Raios UV: ");
    display.print(piranometroPainel); // Porcentagem da quantidade de Raios Ultravioletas oriundos da incidencia solar
    display.print("%");               // Porcentagem da quantidade de Raios Ultravioletas oriundos da incidencia solar
    // display.println("ALERTA: \nALTO INDICE DE RAIOS UV");   // Mensagem para aviso de altos índices de radiação apresentados
    display.display(); // Faz com que toda informação de texto seja exibida no monitor
}

void painel_info_termometro()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.print("TERMOMETRO: ");
    display.print(temperaturaPainel);
    display.println(" \tC"); // Registro de temperatura em °C e °F
    display.println("");
    display.print("MEDIA: ");     // Temperatura máxima registrada no dia
    display.print(tempAvgPainel); // Temperatura máxima registrada no dia
    display.println(" \tC");      // Temperatura máxima registrada no dia
    display.println("");
    display.print("MAXIMA: ");    // Temperatura máxima registrada no dia
    display.print(tempMaxPainel); // Temperatura máxima registrada no dia
    display.println(" \tC");      // Temperatura máxima registrada no dia
    display.println("");
    display.print("MINIMA: ");    // Temperatura mínima registrada no dia
    display.print(tempMinPainel); // Temperatura mínima registrada no dia
    display.println(" \tC");      // Temperatura mínima registrada no dia
    // display.println("ALERTA: ONDAS FORTES DE CALOR");   // Mensagem para aviso de altas temperaturas resgistradas
    display.display(); // Faz com que toda informação de texto seja exibida no monitor
}

void painel_info_umidade()
{
    formatacaoDisplay(); // Formata o display para exibir as informações
    display.print(" UMIDADE RELATIVA DO AR: ");
